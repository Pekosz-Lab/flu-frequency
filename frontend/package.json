  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "vega": "6.4.0",
    "vega-embed": "7.2.0",
    "vega-lite": "6.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.49.1",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.7.3",
    "vite": "6.0.11"
  }
}
